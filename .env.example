# Copy to .env (gitignored) and fill in. Never commit real keys.

# LLM for the agent (any one provider). If no key is set, the agent is unavailable and the
# explorer offers a clearly labelled deterministic mode instead.
# LLM_PROVIDER picks one explicitly (openrouter | deepseek); otherwise the first key set wins.
LLM_PROVIDER=

# OpenRouter (keys start with "sk-or-")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-5.5-sonnet

# DeepSeek (OpenAI-compatible API at https://api.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# disabled (default): answer directly, 1-3 s per agent turn. enabled: hidden reasoning, 15-70 s per hard turn.
DEEPSEEK_THINKING=disabled

# Wikimedia-compliant User-Agent for live Wikidata requests:
# "<project-name>/<version> (<contact URL or email>)"
# See https://meta.wikimedia.org/wiki/User-Agent_policy
WIKIDATA_USER_AGENT=

# Entity photos in the graph (Wikidata P18, looked up live and cached in data/wikidata/cache/).
# 0 turns the lookups off; cached answers are still used. Settings: images: in config/search.yaml.
# WIKIDATA_IMAGES=0
